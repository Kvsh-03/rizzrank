{
  "rules": {
    ".read": false,
    ".write": false,

    "active_states": {
      "$matchId": {
        ".read": "auth != null",
        ".write": false,

        "is_typing": {
          ".write": "auth != null",
          ".validate": "(newData.isString() && newData.val().length <= 128) || !newData.exists()"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['is_online', 'last_seen'])",

        "is_online": {
          ".validate": "newData.isBoolean()"
        },
        "last_seen": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
