rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Users: profiles
    //   - Any signed-in user can READ (leaderboards, opponent info).
    //   - Owner can CREATE their profile on first sign-in.
    //   - Owner can UPDATE display_name, rizz_title, last_played only.
    //   - Server-managed fields (elo_rating, total_games, wins, losses)
    //     are protected from client writes.
    //   - No client deletes.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['elo_rating', 'total_games', 'wins', 'losses', 'active_match_id', 'leaderboard_rank']);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // AI Models: read-only reference data
    //   - Any signed-in user can read character definitions.
    //   - All writes are server-only (Admin SDK seeding).
    // ─────────────────────────────────────────────────────────────────────────
    match /ai_models/{modelId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Traits: read-only reference data for AI persona generation
    //   - Any signed-in user can read trait categories.
    //   - All writes are server-only (Admin SDK seeding).
    // ─────────────────────────────────────────────────────────────────────────
    match /traits/{category} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Matches: game results & archive
    //   - Players can only READ matches they are part of.
    //   - ALL writes (create/update/delete) are server-only.
    //     Cloud Functions create matches during matchmaking and
    //     update them on finalization.
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.get('player_ids', []);
      allow create: if false;
      allow update, delete: if false;

      // ───────────────────────────────────────────────────────────────────────
      // Private player message shards: matches/{matchId}/players/{playerId}/messages/{messageId}
      //   - A player can only READ and CREATE messages in their own shard.
      //   - sender_uid must match the authenticated user's UID.
      //   - Required fields: sender_uid, role, content, timestamp.
      //   - No updates or deletes (server-only via Admin SDK).
      // ───────────────────────────────────────────────────────────────────────
      match /players/{playerId}/messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid == playerId;
        allow create: if isSignedIn()
          && request.auth.uid == playerId
          && request.resource.data.sender_uid == request.auth.uid
          && request.resource.data.keys().hasAll(['sender_uid', 'role', 'content', 'timestamp']);
        allow update, delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Matchmaking queue
    //   - All operations are server-only (Cloud Functions callable).
    //   - No client reads or writes.
    // ─────────────────────────────────────────────────────────────────────────
    match /matchmaking/{userId} {
      allow read, write: if false;
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
